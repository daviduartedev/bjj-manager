# =====================================================
# Casca , Gestão de Academias de BJJ · variáveis de ambiente
# =====================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commit .env.local no Git.

# -----------------------------------------------------
# Supabase - Public (cliente browser)
# -----------------------------------------------------
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------
# Supabase - Server-side (NUNCA expor no cliente)
# -----------------------------------------------------
# Service role bypassa RLS - usar apenas em rotas server-side criticas (ex: webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Connection string Postgres , usado por `pnpm db:apply`. Password = Database password no dashboard, não as API keys.
# Direct (exemplo): postgresql://postgres:SUA_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Opcional: senha de teste para pnpm db:validate-rls (emails maikon@aslam.com.br e rls-validation-b@aslam.com.br)
# VALIDATION_TEST_PASSWORD=

# -----------------------------------------------------
# App
# -----------------------------------------------------
# URL pública da app (links WhatsApp, assinatura). Em produção na Vercel,
# o runtime prefere VERCEL_PROJECT_PRODUCTION_URL para evitar DEPLOYMENT_NOT_FOUND.
# Use APP_URL para forçar um domínio canónico (ex.: https://app.aslam.com.br).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=https://seu-dominio.com
NEXT_PUBLIC_APP_NAME="Casca BJJ"

# -----------------------------------------------------
# PDF / documentos (**REC-3**) — servidor Node (server actions / lib/documents/renderer)
# -----------------------------------------------------
# Se omitido: host local/dev → playwright; VERCEL=1 → chama só a Lambda da rota interna (+ puppeteer + @sparticuz/chromium).
# PDF_RENDERER_DRIVER=playwright-local
# PDF_RENDERER_DRIVER=puppeteer-serverless

# Produção na Vercel — obrigatório (Bearer na rota /api/internal/pdf-from-html ; mín. 24 caracteres).
# Gerar algo aleatório: openssl rand -base64 32
# PDF_INTERNAL_RENDER_TOKEN=

# Se o projecto tiver Deployment Protection (Vercel Authentication / password), activar no dashboard
# “Protection Bypass for Automation”. A Vercel injeita **VERCEL_AUTOMATION_BYPASS_SECRET** nas Lambdas.
# Se esse valor não aparecer nas variáveis (ambiente antigo ou bug), cópia o mesmo valor do dashboard aqui:
# PDF_DEPLOYMENT_PROTECTION_BYPASS=
# O renderizador envia bypass no header **e** na query do self-fetch (URL = **VERCEL_URL**).

# Diagnóstico temporário: resposta 500 inclui campo `detail` na rota interna PDF (mensagem sanitizada).
# PDF_RENDERER_EXPOSE_ERRORS=1

# Opcional: **PDF_RENDER_ORIGIN** — apenas se precisares de forçar outro host (URL sem `/` final).
# Por defeito usa **VERCEL_URL** para evitar **DEPLOYMENT_NOT_FOUND**.
# PDF_RENDER_ORIGIN=https://example.com
# -----------------------------------------------------
# Locale
# -----------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------
# Assinatura da academia no Casca (nao e a mensalidade dos alunos)
# -----------------------------------------------------
# Todas as variaveis abaixo ficam apenas no servidor. Nunca usar NEXT_PUBLIC_ nas chaves.
# Primeiro configure sandbox; producao exige conta/cartao aprovados e webhook HTTPS proprio.
CASCA_ABACATEPAY_API_KEY=
CASCA_ABACATEPAY_ENV=sandbox
CASCA_ABACATEPAY_WEBHOOK_SECRET=

# Produtos MONTHLY com preco 9900 / 17900 / 29900 centavos.
# As variantes _TRIAL possuem trialDays:3; as outras nao possuem trial.
CASCA_ABACATEPAY_PRODUCT_ESSENCIAL=
CASCA_ABACATEPAY_PRODUCT_ESSENCIAL_TRIAL=
CASCA_ABACATEPAY_PRODUCT_ACADEMIA=
CASCA_ABACATEPAY_PRODUCT_ACADEMIA_TRIAL=
CASCA_ABACATEPAY_PRODUCT_EVOLUCAO=
CASCA_ABACATEPAY_PRODUCT_EVOLUCAO_TRIAL=

# UUID do unico dono da plataforma, obtido em Supabase Auth (nao e account_id).
CASCA_PLATFORM_ADMIN_USER_ID=
# Canal real para capacidade acima de 300 alunos, opcional (https: ou mailto:).
CASCA_CONTACT_URL=

# Resend comercial. O SMTP do Supabase Auth e configurado separadamente no dashboard.
# Remetente deve usar um dominio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Bearer forte para o job de notificacoes; configurar agendador a cada 15 minutos.
# Endpoint GET/POST /api/internal/subscriptions/notifications.
# Nao adicionar cron horario em Vercel Hobby (permite somente execucao diaria).
CRON_SECRET=

# Ativacao comercial usa public.casca_billing_settings.enforcement_enabled no banco.
# Inicia false; so ativar apos isentar explicitamente as duas academias atuais.
# Roteiro: cycles/Q42026/1029-assinaturas-admin-casca/activation-checklist.md
